{
  "name": "dsh-workspace-preset",
  "version": "0.1.1",
  "description": "按工作区指定新会话的 agent preset；未配置的工作区回落到宿主全局默认",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js"
  },
  "files": [
    "lib/**/*.js",
    "client.js",
    "cordis.patch.yml",
    "scripts/**/*.mjs",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "agent-preset",
    "workspace"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node scripts/test-all.mjs",
    "test:logic": "node scripts/resolve-test.mjs",
    "test:client": "node scripts/client-structure-test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-workspace": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent-preset-registry": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-workspace": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
